# Local development only. If omitted, the local code is PREVENT-LOCAL.
PREVENT_LOCAL_ACCESS_CODE=PREVENT-LOCAL

# Production fails closed unless both values below are configured.
# Use a random secret of at least 32 bytes and never commit it.
PREVENT_SESSION_SECRET=

# Comma-separated HMAC-SHA256 hashes generated with:
# PREVENT_SESSION_SECRET='…' npm run auth:hash -- 'HF-XXXX-XXXX'
PREVENT_ACCESS_CODE_HASHES=
